# Maintainer: vivosAi <https://github.com/vivosAi>
#
# The prebuilt binary: no Rust toolchain, installs in seconds. To build from
# source instead, see the nimbus-wayland package.

pkgname=nimbus-wayland-bin
_pkgname=nimbus-wayland
pkgver=0.1.0
pkgrel=1
pkgdesc="Draws an animated ring of light around the window that has keyboard focus (prebuilt)"
# Only x86_64 has a prebuilt tarball; aarch64 builds from the source package.
arch=('x86_64')
url="https://github.com/vivosAi/nimbus-wayland"
license=('MIT')

depends=('wayland' 'libglvnd' 'gcc-libs' 'libffi')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
optdepends=('omarchy: bar control panel (run `nimbus-wayland install-bar`)')

install="${_pkgname}.install"
source_x86_64=("${_pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}-${pkgver}-x86_64.tar.gz")
sha256sums_x86_64=('SKIP')   # replaced with the real digest when the release is cut

package() {
  # The tarball unpacks into a versioned directory, as build-release.sh makes it.
  cd "${_pkgname}-${pkgver}-${CARCH}"

  install -Dm755 nimbus-wayland "${pkgdir}/usr/bin/nimbus-wayland"
  install -Dm644 nimbus-wayland.service \
    "${pkgdir}/usr/lib/systemd/user/nimbus-wayland.service"
  install -Dm644 -t "${pkgdir}/usr/share/nimbus-wayland/omarchy/nimbus.ring" \
    omarchy/nimbus.ring/manifest.json \
    omarchy/nimbus.ring/Panel.qml \
    omarchy/nimbus.ring/NimbusMark.qml
  install -Dm644 config.example.json \
    "${pkgdir}/usr/share/nimbus-wayland/config.example.json"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
}
