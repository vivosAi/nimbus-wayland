# Printed by pacman after installing. This is where a package gets to say the
# one thing it cannot do for you: anything inside your home directory.

post_install() {
  cat <<'MSG'

  Nimbus is installed, but not running and not set to start.

  Arch packages never enable services for you, so that step is yours:

      nimbus-wayland autostart on     starts it now, and at every login
      nimbus-wayland install-bar      adds the control to the Omarchy bar

  To see what you have at any point:

      nimbus-wayland setup

  Settings live in ~/.config/nimbus/config.json; a commented example is at
  /usr/share/nimbus-wayland/config.example.json, and every setting is also a
  command (nimbus-wayland --help).

MSG
}

post_upgrade() {
  cat <<'MSG'

  Nimbus upgraded. Restart it to pick up the new build:

      nimbus-wayland quit && nimbus-wayland start

MSG
}

pre_remove() {
  systemctl --user --global disable nimbus-wayland.service >/dev/null 2>&1 || true
}
